# Copy to .env and adjust. Read by compose.yaml.

# The folder holding all your notes (absolute path). With OneDrive, enable "Always keep on this
# device" on it: Docker can't read online-only files.
MYFLUENCE_DATA_DIR=/Users/you/Library/CloudStorage/OneDrive-Personal/Myfluence

# Port on this computer (the app is only reachable from it).
MYFLUENCE_PORT=3000

# Set to true if changes made outside the app (by agents, in Finder) are not picked up.
MYFLUENCE_WATCH_POLLING=false
