# The website's files. HTTPS and the domain are DokWalt's proxy's job: this only serves :8080.
:8080 {
	root * /srv
	encode zstd gzip
	# Build files are named after their content: cached for good. Pages are checked each time.
	@pages not path /_app/*
	header /_app/* Cache-Control "public, max-age=31536000, immutable"
	header @pages Cache-Control "no-cache"
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
