#!/usr/bin/env sh
# Runs the `tandem` CLI in the running Tandem container, from the Mac (where there is no
# Node). Symlink it into your PATH: ln -s "$PWD/bin/tandem" /usr/local/bin/tandem
#
# Host files are sent through standard input, since the container can't see them:
#   tandem attach <note> ./report.pdf    and    tandem append <note> --file ./notes.md
# The author of the changes comes from TANDEM_AUTHOR (e.g. "claude"), default "agent".
set -eu
repo="$(cd "$(dirname "$(readlink -f "$0" 2> /dev/null || echo "$0")")/.." && pwd)"

run() {
  exec docker compose --project-directory "$repo" exec -T \
    -e TANDEM_AUTHOR="${TANDEM_AUTHOR:-agent}" app tandem "$@"
}

# attach <note> <host file> [options]: stream the file.
if [ "${1:-}" = attach ] && [ $# -ge 3 ] && [ -f "$3" ]; then
  note="$2"
  file="$3"
  shift 3
  run attach "$note" - --name "$(basename "$file")" "$@" < "$file"
fi

# --file <host file>: stream it as the content.
file=""
for arg in "$@"; do
  shift
  if [ "$file" = next ]; then
    file="$arg"
    continue
  fi
  if [ "$arg" = --file ]; then
    file=next
    continue
  fi
  set -- "$@" "$arg"
done
if [ -n "$file" ] && [ "$file" != next ]; then
  run "$@" < "$file"
fi
run "$@"
